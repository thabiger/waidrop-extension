{
  "manifest_version": 3,
  "name": "WAiDrop: WhatsApp Chat Archiver",
  "version": "1.0.0",
  "minimum_chrome_version": "102",
  "description": "Archive WhatsApp Web chats locally and encrypted to Dropbox, with full-resolution media, full-history sync and offline catch-up.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "identity",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://api.dropboxapi.com/*",
    "https://content.dropboxapi.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "utils/buildFlags.js",
        "utils/mediaSettings.js",
        "utils/messageParser.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
